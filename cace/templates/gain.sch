C {devices/code_shown.sym} -1040 -340 0 0 {name=CONTROL only_toplevel=false value=".control
ac dec 10 1 10Meg
let gain = db(V(Vout))
let cutoff_db = vecmax(gain)-3.0
meas ac bw WHEN gain=cutoff_db FALL =1
meas ac max_gain MAX gain
echo $&max_gain $&bw > CACE\{simpath\}/CACE\{filename\}_CACE\{N\}.data
set gnuplot_terminal=png/quit
gnuplot ac gain
+ title 'Differential gain'
+ xlabel 'Freq' ylabel 'Gain dB'

quit
.endc
"}
C {devices/code_shown.sym} -1050 -610 0 0 {name=SETUP only_toplevel=false value="* CACE gensim simulation file CACE\{filename\}_CACE\{N\}
* Generated by CACE gensim, Efabless Corporation (c) 2023
* Find the noise in the driver amplifier

.include CACE\{DUT_path\}

.lib CACE\{PDK_ROOT\}/CACE\{PDK\}/libs.tech/combined/sky130.lib.spice CACE\{corner\}

.option TEMP=CACE\{temperature\}
* Flag unsafe operating conditions (exceeds models' specified limits)
.option warn=1
.option rshunt=1e12
"}
