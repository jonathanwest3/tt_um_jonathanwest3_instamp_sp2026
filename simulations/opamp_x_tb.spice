** sch_path: /home/jwest/ece6120/hw05/xschem/opamp_x_tb.sch
**.subckt opamp_x_tb
Vdd VDD 0 3.3
C1 Vref 0 100n
Vin Vin Vmid 0 sin(0 0.7 1k) AC=1
R1 net2 net1 1Meg
R2 Vmid net1 1Meg
Vmid Vmid 0 1.65
L5 Vout net2 1G
x2 Vin Vout_mag net3 Vref_mag opamp_bg
x1 Vin Vout net1 Vref opamp_bg_x
C2 Vref_mag 0 100n
R4 net4 net3 1Meg
R5 Vmid net3 1Meg
L10 Vout_mag net4 1
**** begin user architecture code

** opencircuitdesign pdks install
.lib /home/jwest/.ciel/sky130A/libs.tech/combined/sky130.lib.spice tt



.option wnflag=1
.option savecurrents
.option rshunt=1e12
.include ../gds/opamp.spice
.save all
.control
op
write opamp_x_tb.raw
print Vref I(v.x1.x2.vmeas_iref) V(x1.x2.Vg1)
if 0
alter L5 1n
tran 1u 2m
plot V(Vin) V(Vout) title 'Vin and Vout vs time'
endif

alter L5 10G
alter L10 10G
ac dec 100 1 100Meg
plot db(V(Vout)) db(V(Vout_mag)) title 'Vout vs Vout_mag Open loop'
*plot cph(V(vout))*180/pi title 'Phase Vout open loop'

if 1
alter L5 1n
alter L10 1n
alter R1 1m
alter R4 1m
ac dec 100 1 100Meg
plot db(V(Vout)) db(V(Vout_mag)) title 'Mag Unity gain'
*plot cph(V(vout))*180/pi title 'Phase Vout Unity gain'
endif

.endc


**** end user architecture code
**.ends

